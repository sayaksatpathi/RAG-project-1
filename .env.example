# RAGBench configuration. Copy to .env and adjust. NEVER commit real secrets.

# Storage backend: "sqlite" (default, offline) or "postgres"
RAGBENCH_STORAGE=sqlite
RAGBENCH_SQLITE_PATH=data/ragbench.db
# RAGBENCH_POSTGRES_DSN=postgresql://user:pass@localhost:5432/ragbench

# Embedding provider: "fake" (default, deterministic, offline) or "sentence-transformers"
RAGBENCH_EMBEDDING_PROVIDER=fake
RAGBENCH_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAGBENCH_EMBEDDING_DIM=256

# Generation provider: "mock" (default, deterministic, offline) or "openai"
RAGBENCH_LLM_PROVIDER=mock
# RAGBENCH_OPENAI_API_KEY=__set_in_env_not_here__
RAGBENCH_OPENAI_BASE_URL=https://api.openai.com/v1
RAGBENCH_LLM_MODEL=gpt-4o-mini

# Retrieval
RAGBENCH_TOP_K=5
RAGBENCH_RRF_K=60
RAGBENCH_ABSTAIN_MIN_SCORE=0.15

# API auth (development default token; override in deployment)
RAGBENCH_API_TOKEN=dev-local-token
